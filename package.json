{
  "name": "@ramstack/mqpacker",
  "version": "1.0.1",
  "description": "PostCSS plugin that packs identical media queries into one. Supports CSS nesting, cascade layers, @container and range syntax.",
  "type": "module",
  "author": "rameel <rameel-b@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rameel/ramstack.mqpacker.js.git"
  },
  "exports": {
    ".": {
      "types": "./dist/mqpacker.d.ts",
      "default": "./dist/mqpacker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rolldown -c",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "postcss",
    "postcss-plugin",
    "css",
    "media",
    "media-queries",
    "mqpacker",
    "css-mqpacker",
    "pack",
    "merge",
    "optimization"
  ],
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "postcss": "^8.5.33",
    "rolldown": "^1.3.2",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
